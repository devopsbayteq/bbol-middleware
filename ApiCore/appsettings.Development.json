{
  "Cors": {
    "NamePolicy": "default",
    "Origins": [
      "https://localhost:5001",
      "http://localhost:5000",
      "https://localhost:7041",
      "http://localhost:3000",
      "http://127.0.0.1:3000",
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "Serilog": {
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] ({RequestId}) {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341/"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log.txt"
        }
      }
    ]
  }
}
